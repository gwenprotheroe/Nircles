{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "fs:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-python-scanner",
          "cmd": "python",
          "args": ["src/scanner.py", "$0"]
        },
        {
          "name": "binaries/scanner",
          "sidecar": true,
          "args": [
            { "validator": "(.*)" }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "run-python-scanner",
          "cmd": "python",
          "args": ["src/scanner.py", "$0"]
        },
        {
          "name": "binaries/scanner",
          "sidecar": true,
          "args": [
            { "validator": "(.*)" }
          ]
        }
      ]
    }
  ]
}