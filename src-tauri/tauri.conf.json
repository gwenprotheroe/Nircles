{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nircles",
  "version": "0.2.3",
  "identifier": "com.gwen.nircles",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nircles",
        "width": 1500,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin":["binaries/scanner"],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "entitlements": null
    },
    "icon": [
      "icons/nircles.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
